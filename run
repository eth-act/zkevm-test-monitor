#!/bin/bash
# run - Main entry point for ZKVM testing

set -e

CMD=${1:-help}
shift || true

# run_eth_act_standards_tests [zkvm ...] — run the eth-act standards tests for the
# given zkVMs, or for every zkVM that has a platform in eth-act-standards-tests/.
run_eth_act_standards_tests() {
    local zkvms="$*"
    if [ -z "$zkvms" ]; then
        for dir in eth-act-standards-tests/platforms/*/; do
            zkvms="$zkvms $(basename "$dir")"
        done
    fi
    for zkvm in $zkvms; do
        ./src/run-eth-act-standards-tests.sh "$zkvm" \
            || echo "  Warning: eth-act standards tests failed for $zkvm"
    done
}

case "$CMD" in
    build)
        echo "Building ZKVMs: ${@:-all}"
        ./src/build.sh "$@"
        ;;

    isa-tests)
        echo "Running ISA tests: ${@:-all}"
        ./src/run-isa-tests.sh "$@"
        ;;

    eth-act-standards-tests)
        echo "Running eth-act standards tests: ${@:-all with a platform}"
        run_eth_act_standards_tests "$@"
        ;;

    tests)
        echo "Running ISA tests and eth-act standards tests: ${@:-all}"
        ./src/run-isa-tests.sh "$@"
        run_eth_act_standards_tests "$@"
        ;;

    all)
        echo "Building and testing: ${@:-all}"
        ./src/build.sh "$@"
        ./src/run-isa-tests.sh "$@"
        run_eth_act_standards_tests "$@"
        ;;

    serve)
        echo "Server at http://0.0.0.0:9586/"
        echo "   Press Ctrl+C to stop"
        cd docs && python3 -c "
import http.server
class H(http.server.SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
        super().end_headers()
http.server.HTTPServer(('0.0.0.0', 9586), H).serve_forever()
"
        ;;

    clean)
        TARGETS="${@:-all}"
        if [ "$TARGETS" = "all" ]; then
            echo "Cleaning all artifacts"
            ZKVMS=""
            for dir in test-results/*/; do
                [ -d "$dir" ] && ZKVMS="$ZKVMS $(basename "$dir")"
            done
        else
            echo "Cleaning artifacts for: $TARGETS"
            ZKVMS="$TARGETS"
        fi
        for zkvm in $ZKVMS; do
            if [ -d "test-results/$zkvm/elfs" ]; then
                docker run --rm -v "$PWD/test-results/$zkvm/elfs:/elfs" ubuntu:24.04 rm -rf /elfs/native /elfs/target 2> /dev/null || true
            fi
            rm -rf "test-results/$zkvm"
            rm -f "binaries/${zkvm}-binary"
            if [ "$zkvm" = "zisk" ]; then
                rm -f binaries/cargo-zisk binaries/cargo-zisk-cuda binaries/libzisk_witness.so
                rm -rf binaries/zisk-lib
            fi
        done
        if [ "$TARGETS" = "all" ]; then
            rm -f act4-runner/target/release/act4-runner act4-runner/target/release/eth-act-standards-runner
        fi
        ;;

    *)
        cat << EOF
Usage: ./run COMMAND [OPTIONS]

Commands:
  build [zkvm ...]          Build ZKVM binaries
  isa-tests [zkvm ...]      Run the ISA tests (ACT4 RISC-V compliance)
  eth-act-standards-tests [zkvm ...]
                            Run the eth-act standards tests (I/O, accelerators,
                            memory operations; zisk, sp1, openvm; execute only)
  tests [zkvm ...]          Run both test suites
  all [zkvm ...]            Build + both test suites
  serve                     Start local web server at 0.0.0.0:9586
  clean [zkvm ...]          Remove build artifacts (all or specific ZKVMs)

Environment Variables:
  JOBS=N                    Limit to N CPU cores
  ACT4_JOBS=N               Override parallel test jobs inside container
  FORCE=1                   Force regeneration of ELFs / rebuild of binaries
  ACT4_MODE=execute|prove|full   Test mode (default: full); applies to
                            zkVMs that support proving (zisk)
  GPU=1                    Build/use GPU variants for Zisk proving

Examples:
  ./run build sp1
  ./run tests sp1 openvm                   # both suites for two zkVMs
  ./run tests                              # both suites for all zkVMs
  ./run isa-tests zisk                     # ISA tests only
  ./run eth-act-standards-tests sp1        # eth-act standards tests only
  ./run all
  JOBS=8 ./run tests zisk
  ACT4_MODE=execute ./run isa-tests zisk   # ISA tests without proving
  GPU=1 ./run build zisk                   # build with GPU support
  GPU=1 ./run isa-tests zisk               # use GPU for proving
  FORCE=1 ./run isa-tests zisk             # regenerate ISA test ELFs
EOF
        ;;
esac
